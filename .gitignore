# ── ROS 2 build artifacts ──────────────────────────────────────────────────────
build/
install/
log/

# ── Python cache (all packages, any depth) ────────────────────────────────────
**/__pycache__/
*.pyc
*.pyo

# ── Python packaging artifacts ────────────────────────────────────────────────
*.egg-info/
dist/
.eggs/

# ── Generated files written by the wizard at runtime ─────────────────────────
# These are user-specific outputs and differ between machines/sessions.
# Template sources (mobRob_*.xacro, gazebo_ros2_control_*.xacro, etc.) are kept.
src/mobRobURDF_description/urdf/mobRob.urdf
src/mobRobURDF_description/urdf/user_sensors.xacro
src/mobRobURDF_description/urdf/selected_controller.txt

# Gazebo bridge configs regenerated by the wizard on every URDF Apply
src/mobRobURDF_gazebo/config/gz_bridge_generated.yaml
src/mobRobURDF_gazebo/config/gz_image_topics.txt

# ── Editor / OS noise ─────────────────────────────────────────────────────────
.DS_Store
*.swp
*~
