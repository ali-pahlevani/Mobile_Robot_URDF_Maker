<?xml version="1.0" ?>
<robot name="mobRob" xmlns:xacro="http://ros.org/wiki/xacro" xmlns:gz="http://gazebosim.org/schema">
  <!-- Xacro parameters -->
  <xacro:property name="chassis_size" value="1.2 0.8 0.3"/>
  <xacro:property name="chassis_mass" value="1.0"/>
  <xacro:property name="chassis_material" value="Gray"/>
  <xacro:property name="wheel_radius" value="0.22"/>
  <xacro:property name="wheel_width" value="0.12"/>
  <xacro:property name="wheel_mass" value="0.5"/>
  <xacro:property name="wheel_material" value="Black"/>
  <xacro:property name="caster_radius" value="0.22"/>
  <xacro:property name="l_x" value="-0.3"/>
  <xacro:property name="l_y" value="0.46"/>
  <xacro:property name="l_z" value="-0.15"/>
  <xacro:property name="r_x" value="-0.3"/>
  <xacro:property name="r_y" value="-0.46"/>
  <xacro:property name="r_z" value="-0.15"/>
  <xacro:property name="caster_x" value="0.38"/>
  <xacro:property name="caster_y" value="0"/>
  <xacro:property name="caster_z" value="-0.15"/>
  <xacro:property name="controller_type" value="diff_2wc"/>
  <xacro:property name="hardware_plugin" value="gz_ros2_control/GazeboSimSystem"/>
  <xacro:property name="use_gazebo_sim" value="1"/>
  <xacro:include filename="$(find mobRobURDF_description)/urdf/submodules/2_wheeled_caster/mobRob_2wc_diff.xacro"/>
  <xacro:include filename="$(find mobRobURDF_description)/urdf/user_sensors.xacro"/>
</robot>