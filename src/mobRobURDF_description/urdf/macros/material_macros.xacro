<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="define_materials">
    <material name="Gray">      <color rgba="0.50 0.50 0.50 1.0"/> </material>
    <material name="Silver">    <color rgba="0.75 0.75 0.75 1.0"/> </material>
    <material name="Dark Gray"> <color rgba="0.25 0.25 0.25 1.0"/> </material>
    <material name="Black">     <color rgba="0.00 0.00 0.00 1.0"/> </material>
    <material name="White">     <color rgba="1.00 1.00 1.00 1.0"/> </material>
    <material name="Red">       <color rgba="1.00 0.00 0.00 1.0"/> </material>
    <material name="Maroon">    <color rgba="0.50 0.00 0.00 1.0"/> </material>
    <material name="Orange">    <color rgba="1.00 0.50 0.00 1.0"/> </material>
    <material name="Yellow">    <color rgba="1.00 1.00 0.00 1.0"/> </material>
    <material name="Green">     <color rgba="0.00 0.80 0.00 1.0"/> </material>
    <material name="Lime">      <color rgba="0.50 1.00 0.00 1.0"/> </material>
    <material name="Teal">      <color rgba="0.00 0.50 0.50 1.0"/> </material>
    <material name="Cyan">      <color rgba="0.00 1.00 1.00 1.0"/> </material>
    <material name="Blue">      <color rgba="0.00 0.00 1.00 1.0"/> </material>
    <material name="Navy">      <color rgba="0.00 0.00 0.50 1.0"/> </material>
    <material name="Purple">    <color rgba="0.50 0.00 0.50 1.0"/> </material>
    <material name="Pink">      <color rgba="1.00 0.40 0.70 1.0"/> </material>
    <material name="Brown">     <color rgba="0.60 0.30 0.10 1.0"/> </material>
  </xacro:macro>

</robot>
