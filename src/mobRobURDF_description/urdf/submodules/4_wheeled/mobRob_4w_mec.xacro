<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Include Xacro files -->
  <xacro:include filename="$(find mobRobURDF_description)/urdf/submodules/4_wheeled/base.xacro" />
  <xacro:include filename="$(find mobRobURDF_description)/urdf/submodules/4_wheeled/wheels.xacro" />
  <xacro:include filename="$(find mobRobURDF_description)/urdf/macros/inertial_macros.xacro" />
  <xacro:include filename="$(find mobRobURDF_description)/urdf/macros/material_macros.xacro" />

  <!-- Call the macro to define materials -->
  <xacro:define_materials/>

  <!-- Define the robot -->
  <xacro:chassis size="${chassis_size}" mass="${chassis_mass}" material="${chassis_material}" wheel_radius="${wheel_radius}" />

  <!-- Wheels — sphere collision for reliable mecanum strafing (visual stays a cylinder) -->
  <xacro:wheel name="front_left" radius="${wheel_radius}" width="${wheel_width}" mass="${wheel_mass}" material="${wheel_material}" x="${fl_x}" y="${fl_y}" z="${fl_z}" collision_geom="sphere" />
  <xacro:wheel name="front_right" radius="${wheel_radius}" width="${wheel_width}" mass="${wheel_mass}" material="${wheel_material}" x="${fr_x}" y="${fr_y}" z="${fr_z}" collision_geom="sphere" />
  <xacro:wheel name="rear_left" radius="${wheel_radius}" width="${wheel_width}" mass="${wheel_mass}" material="${wheel_material}" x="${rl_x}" y="${rl_y}" z="${rl_z}" collision_geom="sphere" />
  <xacro:wheel name="rear_right" radius="${wheel_radius}" width="${wheel_width}" mass="${wheel_mass}" material="${wheel_material}" x="${rr_x}" y="${rr_y}" z="${rr_z}" collision_geom="sphere" />

  <!-- Include Gazebo Xacro files -->
  <xacro:include filename="$(find mobRobURDF_description)/urdf/gazebo_files/control/gazebo_ros2_control_4w_mec.xacro" />
  <xacro:include filename="$(find mobRobURDF_description)/urdf/gazebo_files/gazebo_properties.xacro" />
  <xacro:gazebo_physical_properties
  controller_type="${controller_type}"
  chassis_size="${chassis_size}"
  wheel_radius="${wheel_radius}"
  wheel_width="${wheel_width}"/>
  <xacro:include filename="$(find mobRobURDF_description)/urdf/gazebo_files/gazebo_colors.xacro" />
  <xacro:gazebo_visual_colors
  controller_type="${controller_type}"
  chassis_material="${chassis_material}"
  wheel_material="${wheel_material}"/>
</robot>
