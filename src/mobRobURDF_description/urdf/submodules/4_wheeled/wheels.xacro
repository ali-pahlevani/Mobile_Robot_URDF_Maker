<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Include the inertial_macros.xacro file -->
  <xacro:include filename="$(find mobRobURDF_description)/urdf/macros/inertial_macros.xacro" />

  <!-- Wheel Macro -->
  <!-- collision_geom: "cylinder" (default) or "sphere". A spherical collision
       gives a single stable contact point, which the mecanum friction model
       (anisotropic fdir1) needs to strafe reliably. The visual stays a cylinder
       so the wheel still looks normal. -->
  <xacro:macro name="wheel" params="name radius width mass material x y z collision_geom:=cylinder">
    <link name="${name}_wheel">
      <inertial>
        <mass value="${mass}" />
        <origin xyz="0 0 0" rpy="${pi/2} 0 0" />
        <!-- Use the cylinder_inertia macro from inertial_macros.xacro -->
        <xacro:cylinder_inertia mass="${mass}" r="${radius}" h="${width}" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0" />
        <geometry>
          <cylinder radius="${radius}" length="${width}" />
        </geometry>
        <material name="${material}" />
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0" />
        <geometry>
          <xacro:if value="${collision_geom == 'sphere'}">
            <sphere radius="${radius}" />
          </xacro:if>
          <xacro:unless value="${collision_geom == 'sphere'}">
            <cylinder radius="${radius}" length="${width}" />
          </xacro:unless>
        </geometry>
      </collision>
    </link>
    <joint name="${name}_joint" type="continuous">
      <parent link="chassis" />
      <child link="${name}_wheel" />
      <origin xyz="${x} ${y} ${z}" rpy="0 0 0" />
      <axis xyz="0 1 0" />
    </joint>
  </xacro:macro>
</robot>